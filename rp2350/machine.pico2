; Generated from rp2040/machine.pico by tools/port_rp2350.py. Edit the RP2040 source, then regenerate.
; The Ms. Pac-Man machine around the Z80 core (Z80EmulatorPicoSeries, built with #Z80_MEM_HOOKS=1):
; the memory map, the latches at $5000-$5007, the sound registers, the sprite positions, the
; inputs and DIP switches, the watchdog and the vertical-blank interrupt.
;
; MAME's mspacman_map (src/mame/pacman/pacman.cpp), with its mirrors:
;   $0000-$3FFF, $8000-$BFFF  ROM, the auxiliary board's decoded bank (romstore.pico): writes dropped
;   $4000-$43FF  video RAM    $4400-$47FF colour RAM    $4800-$4BFF nothing: reads $BF, writes dropped
;   $4C00-$4FEF  RAM          $4FF0-$4FFF sprite codes, flips and colours
;   $5000-$5FFF  I/O (address bits 8-11 ignored): writes $00-$3F the latch (bit = address & 7),
;                $40-$5F sound, $60-$6F sprite positions, $C0-$FF the watchdog; reads by bits 6-7:
;                IN0, IN1, DSW1, DSW2 ($00)
;   $6000-$7FFF, $C000-$FFFF  mirrors of $4000-$5FFF (address bits 13 and 15 ignored)
;   I/O port 0 (write): the byte the interrupt puts on the bus - IM 2's vector
; The auxiliary board's decode latch (MAME mspacman_map's overlay): an access to $0038-$003F,
; $03B0-$03B7, $1600-$1607, $2120-$2127, $3FF0-$3FF7, $8000-$8007 or $97F0-$97F7 puts the original
; Pac-Man ROMs in ($0000-$3FFF, mirrored at $8000-$BFFF); an access to $3FF8-$3FFF puts the
; decoded Ms. Pac-Man bank back. The start-up ROM test reads through them. The Z80 core fetches
; opcodes from Z80Mem without hooks, so a switch rewrites the ROM half of Z80Mem (MachineSetBank);
; data reads and writes of those seven pages come through the hooks. (Opcode fetches of the trap
; ranges cannot switch; the program is not known to execute there.)
; Latch bits: 0 interrupt enable (0 also drops a pending interrupt), 1 sound enable, 3 flip
; screen, 4-5 lamps, 6 coin lockout, 7 coin counter.
;
; Timing: the Z80 at 3.072 MHz (18.432 MHz / 6), the frame 384 x 264 pixels at 6.144 MHz =
; 16.5 ms (60.606 Hz) = 50,688 T-states. The interrupt is raised at vertical blank, once a frame,
; when bit 0 of the latch is set. The watchdog resets the machine after 16 frames unwritten.

#MSP_FRAME_TSTATES = 50688
#MSP_FRAME_US = 16500
#MSP_SLICES = 4

Global MspLatch.i, MspIntVector.i, MspDsw1.i=$C9, MspDsw2.i=0
Global MspWatchdog.i, MspWatchdogResets.i, MspRomWrites.i, MspInterrupts.i
Global MspDecoded.i=1, MspBankSwitches.i
Global Dim MspSprPos.a(16)
Global VidShowing.i= -1

Procedure MachineMapPages()
  Protected p.i
  For p=0 To 255
    Z80PageRd(p)=0 : Z80PageWr(p)=0
    If p<$40 Or (p>=$80 And p<$C0) : Z80PageWr(p)=1 : EndIf
    If RomPlain=0 And (p=$00 Or p=$03 Or p=$16 Or p=$21 Or p=$3F Or p=$80 Or p=$97) : Z80PageRd(p)=1 : EndIf
    If p>=$48 And p<$4C : Z80PageRd(p)=1 : Z80PageWr(p)=1 : EndIf
    If (p>=$50 And p<$80) Or p>=$C0 : Z80PageRd(p)=1 : Z80PageWr(p)=1 : EndIf
  Next
EndProcedure

ProcedureRAM MachineLatch(bit.i, value.i)
  If value : MspLatch=MspLatch|(1<<bit) : Else : MspLatch=MspLatch&~(1<<bit) : EndIf
  If bit=0 And value=0 : Z80IntClear() : EndIf
  If bit=1 : WsgEnabled=value : EndIf
EndProcedure

; The ROM half of Z80Mem: 1 = the decoded Ms. Pac-Man bank, 0 = the Pac-Man ROMs.
Procedure MachineSetBank(decoded.i)
  Protected i.i, b.i
  If decoded=MspDecoded : ProcedureReturn : EndIf
  MspDecoded=decoded : MspBankSwitches=MspBankSwitches+1
  If decoded
    RomBuildSpace(@Z80Mem(0))
  Else
    For i=0 To $FFF
      b=PeekA(RomAddr(#ROM_6E)+i) : Z80Mem(i)=b : Z80Mem($8000+i)=b
      b=PeekA(RomAddr(#ROM_6F)+i) : Z80Mem($1000+i)=b : Z80Mem($9000+i)=b
      b=PeekA(RomAddr(#ROM_6H)+i) : Z80Mem($2000+i)=b : Z80Mem($A000+i)=b
      b=PeekA(RomAddr(#ROM_6J)+i) : Z80Mem($3000+i)=b : Z80Mem($B000+i)=b
    Next
  EndIf
EndProcedure

; An access in a trap range switches the bank (-1: not a trap address).
ProcedureRAM.i MachineTrap(addr.i)
  If RomPlain : ProcedureReturn -1 : EndIf     ; plain Pac-Man hardware has no decode latch
  If addr>=$3FF8 And addr<=$3FFF : ProcedureReturn 1 : EndIf
  If (addr>=$0038 And addr<=$003F) Or (addr>=$03B0 And addr<=$03B7) Or (addr>=$1600 And addr<=$1607)
    ProcedureReturn 0
  EndIf
  If (addr>=$2120 And addr<=$2127) Or (addr>=$3FF0 And addr<=$3FF7) Or (addr>=$8000 And addr<=$8007) Or (addr>=$97F0 And addr<=$97F7)
    ProcedureReturn 0
  EndIf
  ProcedureReturn -1
EndProcedure

; Data reads of the pages flagged in Z80PageRd.
ProcedureRAM.i Z80MemRead(addr.i)
  Protected c.i, sel.i, t.i
  If addr<$4000 Or (addr>=$8000 And addr<$C000)
    t=MachineTrap(addr)
    If t>=0 : MachineSetBank(t) : EndIf
    ProcedureReturn Z80Mem(addr)
  EndIf
  c=addr&$5FFF
  If c<$5000
    If c>=$4800 And c<$4C00 : ProcedureReturn $BF : EndIf
    ProcedureReturn Z80Mem(c)
  EndIf
  sel=(c>>6)&3
  If sel=0 : ProcedureReturn MspIn0 : EndIf
  If sel=1 : ProcedureReturn MspIn1 : EndIf
  If sel=2 : ProcedureReturn MspDsw1 : EndIf
  ProcedureReturn MspDsw2
EndProcedure

; Data writes of the pages flagged in Z80PageWr.
ProcedureRAM Z80MemWrite(addr.i, value.i)
  Protected c.i, o.i, t.i
  If addr<$4000 Or (addr>=$8000 And addr<$C000)
    t=MachineTrap(addr)
    If t>=0 : MachineSetBank(t) : EndIf
    MspRomWrites=MspRomWrites+1 : ProcedureReturn
  EndIf
  c=addr&$5FFF
  If c<$5000
    If c<$4800 Or c>=$4C00 : Z80Mem(c)=value : EndIf
    ProcedureReturn
  EndIf
  o=c&255
  If o<$40
    MachineLatch(o&7,value&1)
  ElseIf o<$60
    WsgRegs(o-$40)=value&15
  ElseIf o<$70
    MspSprPos(o-$60)=value
  ElseIf o>=$C0
    MspWatchdog=0
  EndIf
EndProcedure

Procedure.i Z80PortIn(port.i)
  ProcedureReturn $FF
EndProcedure

Procedure Z80PortOut(port.i, value.i)
  If (port&255)=0 : MspIntVector=value&255 : EndIf
EndProcedure

; Power-on: the Z80, the latches (all clear), the sound and the watchdog. ROM stays as built.
Procedure MachineReset()
  Protected i.i
  For i=$4000 To $4FFF : Z80Mem(i)=0 : Next
  For i=0 To 15 : MspSprPos(i)=0 : Next
  For i=0 To 7 : MachineLatch(i,0) : Next
  For i=0 To 31 : WsgRegs(i)=0 : Next
  MspIntVector=0 : MspWatchdog=0
  Z80Reset()
EndProcedure

; The frame's picture state to core 1: 0 when core 1 is still sending the buffer it would go in
; (the frame is then not shown; the machine runs on).
Procedure.i MachinePublish()
  Protected n.i, s.i, dst.i, i.i
  n=VidPublished+1
  s=PeekL(@VidShowing)
  If s>=0 And (s&1)=(n&1)
    VidDropped=VidDropped+1 : ProcedureReturn 0
  EndIf
  dst=@VidSnap(0)+(n&1)*#SNAP_BYTES
  For i=0 To 2047 : PokeA(dst+i,Z80Mem($4000+i)) : Next
  For i=0 To 15
    PokeA(dst+#SNAP_SPR+i,Z80Mem($4FF0+i))
    PokeA(dst+#SNAP_POS+i,MspSprPos(i))
  Next
  PokeA(dst+#SNAP_FLIP,(MspLatch>>3)&1)
  PokeL(@VidPublished,n)
  ProcedureReturn 1
EndProcedure

; Vertical blank: the picture, the frame's sound, the controls, the watchdog, the interrupt.
Procedure MachineVblank()
  MachinePublish()
  WsgRender(#WSG_FRAME_SAMPLES)
  InputFrame()
  MspWatchdog=MspWatchdog+1
  CompilerIf #MSP_CPU_STANDIN=1
    MspWatchdog=0                    ; no program runs to write $50C0
  CompilerEndIf
  If MspWatchdog>=16
    MspWatchdogResets=MspWatchdogResets+1
    Print("WATCHDOG: 16 frames without a write to $50C0 - machine reset (") : PrintDec(MspWatchdogResets) : PrintN(")")
    MachineReset()
    ProcedureReturn
  EndIf
  If MspLatch&1
    Z80IntRequest(MspIntVector) : MspInterrupts=MspInterrupts+1
  EndIf
EndProcedure

CompilerIf #MSP_CPU_STANDIN=1
; Diagnostics/video_check.picow: a fixed picture in place of the program's (no CPU runs).
Procedure MachineTestPicture()
  Protected i.i
  For i=0 To 1023
    Z80Mem($4000+i)=i&255
    Z80Mem($4400+i)=(i>>5)&31
  Next
  For i=0 To 7
    Z80Mem($4FF0+i*2)=((i*9)&63)<<2|(i&3)
    Z80Mem($4FF0+i*2+1)=(i*5+1)&31
    MspSprPos(i*2)=40+i*24
    MspSprPos(i*2+1)=40+i*28
  Next
  MspSprPos(14)=250 : MspSprPos(15)=8          ; sprite 7 across the clip and the right edge
  MspSprPos(12)=20 : MspSprPos(13)=250         ; sprite 6 near the top, its wrapped copy too
  MachineLatch(0,0)
  ; a steady tone on voice 0 (waveform 0, volume 8, ~440 Hz: 440 x 2^20 / 96000 = 4806 = $012C6)
  WsgRegs($05)=0 : WsgRegs($15)=8
  WsgRegs($10)=6 : WsgRegs($11)=$C : WsgRegs($12)=2 : WsgRegs($13)=1 : WsgRegs($14)=0
  MachineLatch(1,1)
EndProcedure
CompilerEndIf
