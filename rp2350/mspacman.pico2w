; Generated from rp2040/mspacman.picow by tools/port_rp2350.py. Edit the RP2040 source, then regenerate.
; Ms. Pac-Man for the Pico 2 W (RP2350) with the LAFVIN ST7796 kit.
; This published wrapper has no speaker address: the game runs silent. For sound, copy it OUTSIDE
; the repository, put the speaker's address in Speaker (as a phone shows it: AA:BB:CC:DD:EE:FF ->
; Data.a $AA,$BB,$CC,$DD,$EE,$FF) and build the copy with -Source (tools/build.ps1); the copy's
; folder must also reach this one's files, so it includes them by absolute path.
#MSP_CLOCK_KHZ=150000
#MSP_AUDIO=1
#MSP_PHYSICAL_INPUT=1
#MSP_STICK_TURN=1
#MSP_CPU_STANDIN=0
#Z80_TIMED=1
#Z80_ASM_TAIL=1
#Z80_MEM_HOOKS=1
#Z80_Q=1
#Z80_TRACK_R=1
EnableExplicit
XIncludeFile "main.pico2"
Main()
DataSection
Speaker:
  Data.a $00, $00, $00, $00, $00, $00
EndDataSection
